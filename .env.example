# Porta do servidor (padrão: 3001)
PORT=3001

# ── Configuração de e-mail ────────────────────────────────────────────────────
# DEIXE EM BRANCO para usar o Ethereal automático (recomendado para testes).
# Preencha apenas se quiser usar um SMTP real (Gmail, SendGrid, etc.)

EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
